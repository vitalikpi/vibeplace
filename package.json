{
  "name": "jobsearch-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Job Tracker desktop app",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:start": "vite build && electron .",
    "dist": "npm run dist:mac",
    "dist:mac": "vite build && electron-builder --mac dmg --arm64",
    "dist:win": "vite build && electron-builder --win nsis --x64",
    "postinstall": "node scripts/postinstall.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "express": "5.3.0",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/windows-sign": "1.2.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "10.0.6",
    "cross-env": "7.0.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "jsdom": "26.1.0",
    "postcss": "^8.4.49",
    "supertest": "7.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "3.2.7",
    "wait-on": "9.5.1"
  },
  "build": {
    "appId": "local.jobtracker",
    "productName": "Job Tracker",
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node-pty/prebuilds/**"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "identity": null,
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
